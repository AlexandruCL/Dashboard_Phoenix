# Discord OAuth2 app (redirect: <APP_URL>/api/auth/callback, scopes: identify guilds.members.read)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# 32+ random characters, seals the session cookie
SESSION_SECRET=
# The bot's web API on HostMyBot, plain HTTP (traffic is encrypted with WEB_API_KEY)
BOT_API_URL=http://<ip>:<port>
# Same value as WEB_API_KEY in the bot's .env (32 bytes, base64)
WEB_API_KEY=
APP_URL=http://localhost:3000
